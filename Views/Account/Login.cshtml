@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Login" method="post">

    <div class="mb-3">
        <label class="form-label">
            Benutzername
        </label>

        <input type="text"
               name="username"
               class="form-control"
               required />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Passwort
        </label>

        <input type="password"
               name="password"
               class="form-control"
               required />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Login
    </button>

    <a asp-action="Register"
       class="btn btn-secondary">
        Registrieren
    </a>

</form>